# AS Brasil Music — configuração do Apache (Locaweb)
Options -Indexes
DirectoryIndex index.html

# Tipos de arquivo de áudio e do app
AddType audio/mpeg .mp3
AddType audio/mp4 .m4a
AddType audio/aac .aac
AddType audio/flac .flac
AddType audio/ogg .ogg .oga .opus
AddType audio/wav .wav
AddType audio/webm .webm
AddType application/manifest+json .webmanifest

# Bloqueia arquivos internos e de controle
<FilesMatch "(^\.|\.(md|example|lock|log)$|^\.ftp-deploy-sync-state\.json$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|svg|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Forçar HTTPS: tire o "#" das 3 linhas abaixo DEPOIS que o certificado SSL estiver ativo
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

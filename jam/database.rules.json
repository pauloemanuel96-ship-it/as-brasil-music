{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "events": {
      ".read": true,
      "$e": { ".write": "auth != null && root.child('admins').child(auth.uid).exists()" }
    },
    "tokens": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "drivers": {
      "$e": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid === $uid && newData.child('p').isString() && newData.child('k').val() === root.child('tokens').child($e).child(newData.child('p').val()).val()"
        }
      }
    },
    "jams": {
      ".read": true,
      "$e": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$v": {
          ".write": "auth != null && root.child('drivers').child($e).child(auth.uid).exists() && $v.matches(/^[a-z0-9-]{1,20}$/)"
        }
      }
    },
    "listeners": {
      ".read": true,
      "$e": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$v": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
